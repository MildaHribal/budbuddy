<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The diary (CapacitorStorage prefs) and photos (WebView IndexedDB) stay in backups;
     the Supabase session in WebView localStorage does not, so a restored device signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/Local Storage" />
        <exclude domain="root" path="app_webview/Default/Session Storage" />
        <exclude domain="root" path="app_webview/Local Storage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/Local Storage" />
        <exclude domain="root" path="app_webview/Default/Session Storage" />
        <exclude domain="root" path="app_webview/Local Storage" />
    </device-transfer>
</data-extraction-rules>
