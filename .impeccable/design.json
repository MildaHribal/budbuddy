  "narrative": {
    "northStar": "Lights On",
    "overview": "The app is the inside of a grow tent at night with the lamp just switched on. The ground is near-black with a faint diagonal mylar sheen and a warm falloff from a lamp bar at the top edge. Panels are lit from above: a top-to-bottom gradient with a 1px inner highlight. Light is the only colour that means anything: leaf green for growth and action, lamp amber for light and time, full-spectrum pink only for something overdue.\n\nDensity is phone-first and one-handed: 48px controls, a 20px page gutter, sections 28px apart. Big numbers are set light (300) and large; headings are 600. Motion has one signature, the lights-on boot (the lamp flickers, light falls down the tent, the photoperiod ring draws in); everything else is short ease-out.",
    "keyCharacteristics": [
      "Near-black tent ground with mylar sheen and a lamp glow from the top edge.",
      "Top-lit panels: gradient fill, hairline border, inset highlight.",
      "Three signal colours: leaf, lamp, pink. Each has one job.",
      "Sora throughout; light numerals, semibold headings.",
      "Custom duotone line glyphs (1.6 stroke, 20% fill) for stages and entry types."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "Leaf means growth or action, lamp means light or time, pink means overdue. Never swap them, and never use pink for decoration.",
        "section": "colors"
      },
      {
        "name": "The Soft Tint Rule",
        "body": "Signal colours appear as fills at 12% opacity with a 28-35% border (soft buttons, chips, badges); full-strength fills are reserved for the primary button.",
        "section": "colors"
      },
      {
        "name": "The Light Numbers Rule",
        "body": "Any number that is the point of a view is set at weight 300 and large; headings stay at 600. Don't make big numbers bold.",
        "section": "typography"
      },
      {
        "name": "The Top-Lit Rule",
        "body": "Every raised surface is lit from above: lighter at the top edge, a white inset highlight, darkness below. Never light from the side or use offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every raised surface top-lit: panel gradient, 1px line border, inset white highlight.",
      "Do keep leaf for growth and action, lamp for light and time, pink for overdue only.",
      "Do use the well colour with an inset shadow for anything recessed.",
      "Do use Grow Glyphs for stages and entry types; colour them with the stage or entry hue.",
      "Do keep touch targets at 44px or more and inputs at 16px."
    ],
    "donts": [
      "Don't use pink as an accent or decoration; it is reserved for overdue and attention.",
      "Don't use flat grey cards with a green accent stripe; panels are lit, not tinted.",
      "Don't set large numbers bold; they are weight 300.",
      "Don't add coloured glows to anything that isn't a signal element (active state, primary action, lamp)."
    ]
  }
}